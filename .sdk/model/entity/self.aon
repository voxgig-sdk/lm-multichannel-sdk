# Entity: self

main: kit: entity: self: {

  alias: field: {}

  fields: [
    {
      name: "accountId"
      req: true
      short: "Unique technical account identifier"
      type: "`$STRING`"
    }
    {
      name: "settings"
      req: true
      type: "`$OBJECT`"
    }
  ]

  name: "self"
  op: {
    load: {
      name: "load"
      points: [
        {
          method: "GET"
          orig: "/self"
          parts: [
            "self"
          ]
          transform: {
            req: "`reqdata`"
            res: "`body.account`"
          }
        }
      ]
    }
  }



}
