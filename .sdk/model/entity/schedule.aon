# Entity: schedule

main: kit: entity: schedule: {

  alias: field: {}

  fields: [
    {
      name: "count"
      req: true
      short: "Number of active schedules"
      type: "`$INTEGER`"
    }
  ]

  name: "schedule"
  op: {
    load: {
      name: "load"
      points: [
        {
          args: {
            query: [
              {
                example: "2026-02-01T10:00,2026-02-16T20:00"
                kind: "query"
                name: "between"
                orig: "between"
                reqd: false
                type: "`$STRING`"
              }
              {
                kind: "query"
                name: "campaign_id"
                orig: "campaign_id"
                reqd: false
                type: "`$STRING`"
              }
              {
                example: "Europe/Zurich"
                kind: "query"
                name: "time_zone"
                orig: "time_zone"
                reqd: false
                type: "`$STRING`"
              }
            ]
          }
          method: "GET"
          orig: "/schedules:count"
          segments: [
            {
              lit: "schedules:count"
            }
          ]
          select: {
            exist: [
              "between"
              "campaign_id"
              "time_zone"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
    remove: {
      name: "remove"
      points: [
        {
          args: {
            query: [
              {
                kind: "query"
                name: "between"
                orig: "between"
                reqd: false
                type: "`$STRING`"
              }
              {
                kind: "query"
                name: "campaign_id"
                orig: "campaign_id"
                reqd: false
                type: "`$STRING`"
              }
              {
                kind: "query"
                name: "time_zone"
                orig: "time_zone"
                reqd: false
                type: "`$STRING`"
              }
            ]
          }
          method: "DELETE"
          orig: "/schedules"
          segments: [
            {
              lit: "schedules"
            }
          ]
          select: {
            exist: [
              "between"
              "campaign_id"
              "time_zone"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }



}
