# Entity: variable

main: kit: entity: variable: {

  alias: field: {}

  fields: [
    {
      name: "description"
      req: false
      short: "Variable description"
      type: "`$STRING`"
    }
    {
      name: "examples"
      req: false
      short: "Example values"
      type: "`$ARRAY`"
    }
    {
      name: "formats"
      req: false
      short: "Type-specific constraint formats (e.g."
      type: "`$ARRAY`"
    }
    {
      name: "name"
      req: true
      short: "Variable name (alphanumeric + underscore, pattern: [a-zA-Z0-9_]+)"
      type: "`$STRING`"
    }
    {
      name: "ref"
      req: false
      short: "Optional immutable identifier for the variable (used for merge identity)"
      type: "`$STRING`"
    }
    {
      name: "type"
      req: false
      short: "Optional type descriptor for validation constraints"
      type: "`$STRING`"
    }
    {
      name: "variables"
      req: true
      type: "`$ARRAY`"
    }
  ]

  name: "variable"
  op: {
    create: {
      name: "create"
      points: [
        {
          args: {
            params: [
              {
                kind: "param"
                name: "template_id"
                orig: "template_id"
                reqd: true
                type: "`$STRING`"
              }
            ]
          }
          method: "POST"
          orig: "/templates/{templateId}/variables"
          parts: [
            "templates"
            "{template_id}"
            "variables"
          ]
          rename: {
            param: {
              templateId: "template_id"
            }
          }
          select: {
            exist: [
              "template_id"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
    list: {
      name: "list"
      points: [
        {
          args: {
            params: [
              {
                kind: "param"
                name: "template_id"
                orig: "template_id"
                reqd: true
                type: "`$STRING`"
              }
            ]
          }
          method: "GET"
          orig: "/templates/{templateId}/variables"
          parts: [
            "templates"
            "{template_id}"
            "variables"
          ]
          rename: {
            param: {
              templateId: "template_id"
            }
          }
          select: {
            exist: [
              "template_id"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
    update: {
      name: "update"
      points: [
        {
          args: {
            params: [
              {
                kind: "param"
                name: "template_id"
                orig: "template_id"
                reqd: true
                type: "`$STRING`"
              }
            ]
          }
          method: "PATCH"
          orig: "/templates/{templateId}/variables"
          parts: [
            "templates"
            "{template_id}"
            "variables"
          ]
          rename: {
            param: {
              templateId: "template_id"
            }
          }
          select: {
            exist: [
              "template_id"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }

  relations: {
    ancestors: [
      [
        "template"
      ]
    ]
  }



}
