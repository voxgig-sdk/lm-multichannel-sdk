# Entity: traffic_file

main: kit: entity: traffic_file: {

  alias: field: {}

  fields: {
    files: {
      h: "Files"
      n: "files"
      r: true
      t: "`$ARRAY`"
    }
    id: {
      h: "Id"
      n: "id"
      r: false
      t: "`$STRING`"
    }
    path: {
      h: "Path"
      n: "path"
      r: true
      sh: "Relative file path: /events/{year}/{month}/{day}/{hour}/{sequence}.zip"
      t: "`$STRING`"
    }
    url: {
      h: "Url"
      n: "url"
      r: true
      sh: "Absolute download URL with security token (expires after 15 minutes)"
      t: "`$STRING`"
    }
  }

  id: {
    field: "id"
    name: "id"
  }

  name: "traffic_file"
  op: {
    list: {
      name: "list"
      points: [
        {
          co: {
            id: "GET /traffic/files"
            source: "openapi3"
            version: 2
          }
          m: "GET"
          o: "/traffic/files"
          s: [
            {
              lit: "traffic"
            }
            {
              lit: "files"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body.files`"
          }
        }
      ]
    }
    load: {
      name: "load"
      points: [
        {
          co: {
            id: "GET /traffic/files/{path}"
            source: "openapi3"
            version: 2
          }
          g: {
            params: [
              {
                k: "param"
                n: "id"
                or: "path"
                r: true
                t: "`$STRING`"
              }
            ]
          }
          m: "GET"
          o: "/traffic/files/{path}"
          q: {
            exist: [
              "id"
            ]
          }
          r: {
            param: {
              path: "id"
            }
          }
          s: [
            {
              lit: "traffic"
            }
            {
              lit: "files"
            }
            {
              var: "id"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }



}
