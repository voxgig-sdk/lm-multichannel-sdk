# Entity: schedule

main: kit: entity: schedule: {

  alias: field: {}

  fields: {
    count: {
      h: "Count"
      n: "count"
      r: true
      sh: "Number of active schedules"
      t: "`$INTEGER`"
    }
  }

  name: "schedule"
  op: {
    load: {
      name: "load"
      points: [
        {
          co: {
            id: "GET /schedules:count"
            source: "openapi3"
            version: 2
          }
          g: {
            query: [
              {
                ex: "2026-02-01T10:00,2026-02-16T20:00"
                k: "query"
                n: "between"
                or: "between"
                r: false
                t: "`$STRING`"
              }
              {
                k: "query"
                n: "campaign_id"
                or: "campaignId"
                r: false
                t: "`$STRING`"
              }
              {
                ex: "Europe/Zurich"
                k: "query"
                n: "time_zone"
                or: "timeZone"
                r: false
                t: "`$STRING`"
              }
            ]
          }
          m: "GET"
          o: "/schedules:count"
          q: {
            exist: [
              "between"
              "campaign_id"
              "time_zone"
            ]
          }
          s: [
            {
              lit: "schedules:count"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
    remove: {
      name: "remove"
      points: [
        {
          co: {
            id: "DELETE /schedules"
            source: "openapi3"
            version: 2
          }
          g: {
            query: [
              {
                k: "query"
                n: "between"
                or: "between"
                r: false
                t: "`$STRING`"
              }
              {
                k: "query"
                n: "campaign_id"
                or: "campaignId"
                r: false
                t: "`$STRING`"
              }
              {
                k: "query"
                n: "time_zone"
                or: "timeZone"
                r: false
                t: "`$STRING`"
              }
            ]
          }
          m: "DELETE"
          o: "/schedules"
          q: {
            exist: [
              "between"
              "campaign_id"
              "time_zone"
            ]
          }
          s: [
            {
              lit: "schedules"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }



}
