# Entity: traffic

main: kit: entity: traffic: {

  alias: field: {}

  fields: {
    path: {
      h: "Path"
      n: "path"
      r: true
      sh: "Relative file path: /events/{year}/{month}/{day}/{hour}/{sequence}.zip"
      t: "`$STRING`"
    }
    url: {
      h: "Url"
      n: "url"
      r: true
      sh: "Absolute download URL with security token (expires after 15 minutes)"
      t: "`$STRING`"
    }
  }

  name: "traffic"
  op: {
    list: {
      name: "list"
      points: [
        {
          co: {
            id: "GET /traffic/files"
            source: "openapi3"
            version: 2
          }
          m: "GET"
          o: "/traffic/files"
          rs: {
            kind: "json"
            media: "application/json"
          }
          s: [
            {
              lit: "traffic"
            }
            {
              lit: "files"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body.files`"
          }
        }
      ]
    }
    remove: {
      name: "remove"
      points: [
        {
          co: {
            id: "DELETE /traffic/files/{path}"
            source: "openapi3"
            version: 2
          }
          g: {
            params: [
              {
                k: "param"
                n: "path"
                or: "path"
                r: true
                t: "`$STRING`"
              }
            ]
          }
          m: "DELETE"
          o: "/traffic/files/{path}"
          q: {
            exist: [
              "path"
            ]
          }
          s: [
            {
              lit: "traffic"
            }
            {
              lit: "files"
            }
            {
              var: "path"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }



}
