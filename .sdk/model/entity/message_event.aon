          contract: {
            id: "GET /messages/{messageId}/events"
            json: "{\"operationId\":\"getMessageEvents\",\"parameters\":[{\"description\":\"Unique message identifier\",\"in\":\"path\",\"name\":\"messageId\",\"required\":true,\"schema\":{\"type\":\"string\"}},{\"description\":\"Page size for pagination\",\"in\":\"query\",\"name\":\"_pageSize\",\"required\":false,\"schema\":{\"type\":\"integer\"}},{\"description\":\"Zero-based page index\",\"in\":\"query\",\"name\":\"_pageIndex\",\"required\":false,\"schema\":{\"type\":\"integer\"}},{\"description\":\"Sort by property paths with optional asc:/desc: prefix\",\"examples\":{\"newest_first\":{\"summary\":\"Newest events first\",\"value\":\"desc:on\"}},\"in\":\"query\",\"name\":\"_sort\",\"required\":false,\"schema\":{\"type\":\"string\"}}],\"protocol\":\"http\",\"responses\":{\"200\":{\"content\":{\"application/json\":{\"examples\":{\"delivery_outcomes\":{\"summary\":\"GET /messages/{messageId}/events?messageStatusChanged.status=in:DELIVERED,DELIVERY_FAILED&_sort=desc:on\",\"value\":{\"_pageCount\":1,\"_pageSize\":100,\"_totalItemCount\":4,\"events\":[{\"accountId\":\"customer-account-id\",\"eventId\":\"emsc5744b2da290d4132\",\"messageStatusChanged\":{\"channelData\":{\"sms.originatingAddress\":\"MYBRAND\",\"sms.segmentCount\":\"2\"},\"channelId\":\"sms\",\"messageId\":\"msg1uO2aI1Uwz5RHliBXLlZjM\",\"requestId\":\"req600CkeP7HOeMNxmJj6b9Ut\",\"status\":\"DELIVERED\",\"userId\":\"33699999999\"},\"on\":\"2024-11-04T15:38:26.182Z\"}]}},\"optout_events\":{\"summary\":\"GET /messages/{messageId}/events?userMessageReceived.content.optout=exists:true\",\"value\":{\"_pageCount\":1,\"_pageSize\":100,\"_totalItemCount\":1,\"events\":[{\"accountId\":\"customer-account-id\",\"eventId\":\"eum3eFfSK3Zoq2gVvcgP7HVvt\",\"on\":\"2024-11-04T11:12:28.665Z\",\"userMessageReceived\":{\"channelId\":\"sms\",\"content\":{\"optout\":{\"text\":\"STOP\"}},\"replyToMessageId\":\"msg1uO2aI1Uwz5RHliBXLlZjM\",\"userId\":\"33699999999\"}}]}},\"reply_button_clicks\":{\"summary\":\"GET /messages/{messageId}/events?userMessageReceived.content.postback.buttonType=in:reply,openUrl\",\"value\":{\"_pageCount\":1,\"_pageSize\":100,\"_totalItemCount\":2,\"events\":[{\"accountId\":\"customer-account-id\",\"eventId\":\"eumAg77ExuCtUyGB0m4VVYZc0\",\"on\":\"2024-11-04T11:20:58.527Z\",\"userMessageReceived\":{\"channelId\":\"rcs\",\"content\":{\"postback\":{\"buttonType\":\"reply\",\"payload\":\"LOVE\",\"text\":\"J'aime\"}},\"replyToMessageId\":\"msg1uO2aI1Uwz5RHliBXLlZjM\",\"userId\":\"33699999999\"}},{\"accountId\":\"customer-account-id\",\"eventId\":\"eumAUO65Z6IQwIri03xJu3Yf0\",\"on\":\"2024-11-04T11:24:09.626Z\",\"userMessageReceived\":{\"channelId\":\"rcs\",\"content\":{\"postback\":{\"buttonType\":\"openUrl\",\"payload\":\"VISIT_US\",\"text\":\"Visit us\"}},\"replyToMessageId\":\"msg1uO2aI1Uwz5RHliBXLlZjM\",\"userId\":\"33699999999\"}}]}},\"sms_errors_only\":{\"summary\":\"GET /messages/{messageId}/events?messageStatusChanged.channelId=sms&messageStatusChanged.error.code=exists:true\",\"value\":{\"_pageCount\":1,\"_pageSize\":100,\"_totalItemCount\":1,\"events\":[{\"accountId\":\"customer-account-id\",\"eventId\":\"ems2mtzoOqeYkKAjLbvz3yQ1R\",\"messageStatusChanged\":{\"channelId\":\"sms\",\"error\":{\"channelError\":\"Invalid destination address\",\"code\":\"CHANNEL_REJECTED\"},\"messageId\":\"msg1XAXgWzR3X27wjMdxrlJyr\",\"requestId\":\"req4fm8jz3GWtERlrWDw1s0xD\",\"status\":\"DELIVERY_FAILED\",\"userId\":\"33699999999\"},\"on\":\"2024-11-04T17:12:03.737Z\"}]}},\"time_range_paginated\":{\"summary\":\"GET /messages/{messageId}/events?on=between:2024-11-04T15:00:00Z,2024-11-04T16:00:00Z&_pageSize=50\",\"value\":{\"_pageCount\":1,\"_pageSize\":50,\"_totalItemCount\":3,\"events\":[{\"accountId\":\"customer-account-id\",\"eventId\":\"ems7GmGxURd2rQ8BFIEAhiL09\",\"messageStatusChanged\":{\"channelId\":\"rcs\",\"messageId\":\"msg1uO2aI1Uwz5RHliBXLlZjM\",\"requestId\":\"req17nxsvc0w9IwrBIirL5wCq\",\"status\":\"SENT\",\"userId\":\"33699999999\"},\"on\":\"2024-11-04T15:12:03.195Z\"},{\"accountId\":\"customer-account-id\",\"eventId\":\"ems7GmGxURd2rQ8BFIEAhiL10\",\"messageStatusChanged\":{\"channelId\":\"rcs\",\"messageId\":\"msg1uO2aI1Uwz5RHliBXLlZjM\",\"requestId\":\"req17nxsvc0w9IwrBIirL5wCq\",\"status\":\"DELIVERED\",\"userId\":\"33699999999\"},\"on\":\"2024-11-04T15:12:04.231Z\"}]}}},\"schema\":{\"description\":\"Paginated list of messageStatusChanged and userMessageReceived events for a specific message. Does not include templateReviewStatusChanged events.\",\"examples\":[{\"_pageCount\":1,\"_pageSize\":50,\"_totalItemCount\":2,\"events\":[{\"accountId\":\"client-account-id\",\"eventId\":\"ems7GmGxURd2rQ8BFIEAhiL09\",\"messageStatusChanged\":{\"channelId\":\"rcs\",\"messageId\":\"msgSzNvoD1OyIwWDS5KM0GSJ0\",\"requestId\":\"req17nxsvc0w9IwrBIirL5wCq\",\"status\":\"SENT\",\"userId\":\"33699999999\"},\"on\":\"2020-03-06T11:12:03.195Z\"},{\"accountId\":\"client-account-id\",\"eventId\":\"ems7GmGxURd2rQ8BFIEAhiL09\",\"messageStatusChanged\":{\"channelId\":\"rcs\",\"messageId\":\"msgSzNvoD1OyIwWDS5KM0GSJ0\",\"requestId\":\"req17nxsvc0w9IwrBIirL5wCq\",\"status\":\"DELIVERED\",\"userId\":\"33699999999\"},\"on\":\"2020-03-06T11:12:04.231Z\"}]}],\"properties\":{\"_pageCount\":{\"type\":\"integer\"},\"_pageSize\":{\"type\":\"integer\"},\"_totalItemCount\":{\"type\":\"integer\"},\"events\":{\"items\":{\"description\":\"Common event envelope. Exactly one of messageStatusChanged, userMessageReceived,\\nor templateReviewStatusChanged will be present.\\n\",\"examples\":[{\"accountId\":\"vincent-inc\",\"eventId\":\"emsc5744b2da290d4132\",\"messageStatusChanged\":{\"channelId\":\"sms\",\"channelOperatorId\":\"20801\",\"channelStatus\":\"1\",\"context\":{\"myWhateverId\":\"aef5040\"},\"messageId\":\"mfc5c734f85e650\",\"requestId\":\"r4505e54055e450\",\"status\":\"DELIVERED\",\"userId\":\"33607285022\"},\"on\":\"2018-12-23T18:25:43.511Z\"}],\"properties\":{\"accountId\":{\"description\":\"Account identifier\",\"type\":\"string\"},\"eventId\":{\"description\":\"Unique event identifier (for idempotent processing / deduplication)\",\"type\":\"string\"},\"messageStatusChanged\":{\"examples\":[{\"channelData\":{\"sms.originatingAddress\":\"MYBRAND\",\"sms.segmentCount\":\"4\"},\"channelId\":\"sms\",\"channelOperatorId\":\"20801\",\"context\":{\"myCampaignId\":\"christmas-560650\",\"myUserId\":\"vincent@example.com\"},\"messageId\":\"msg1uO2aI1Uwz5RHliBXLlZjM\",\"requestId\":\"req600CkeP7HOeMNxmJj6b9Ut\",\"status\":\"DELIVERED\",\"userId\":\"33699999999\"}],\"properties\":{\"campaignId\":{\"type\":\"string\"},\"channelData\":{\"additionalProperties\":{\"type\":\"string\"},\"examples\":[{\"rcs.card.orientation\":\"HORIZONTAL\",\"sms.originatingAddress\":\"MYBRAND\"}],\"type\":\"object\"},\"channelId\":{\"type\":\"string\"},\"channelOperatorId\":{\"description\":\"Mobile operator ID (MNO) if applicable\",\"type\":\"string\"},\"channelStatus\":{\"description\":\"Channel-native status code\",\"type\":\"string\"},\"context\":{\"additionalProperties\":{\"type\":\"string\"},\"description\":\"Free-form client-specific correlation values (max 50 entries, keys 1-50 chars, values max 500 chars)\",\"examples\":[{\"myCampaignId\":\"christmas-560650\",\"myUserId\":\"vincent@example.com\"}],\"maxProperties\":50,\"type\":\"object\"},\"error\":{\"description\":\"Error details for DELIVERY_FAILED or DELIVERY_RETRIED statuses\",\"examples\":[{\"channelError\":\"404\",\"code\":\"USER_UKNOWN\",\"details\":\"Requested entity was not found.\"}],\"properties\":{\"channelError\":{\"description\":\"Channel-native error code/message\",\"type\":\"string\"},\"code\":{\"description\":\"Message delivery error code\",\"enum\":[\"CLIENT_MESSAGE_INVALID\",\"CLIENT_CONFIGURATION_INVALID\",\"CLIENT_MESSAGE_EXPIRED\",\"CLIENT_QUOTA_EXCEEDED\",\"CLIENT_MESSAGE_FORBIDDEN\",\"CHANNEL_REJECTED\",\"CHANNEL_UNAVAILABLE\",\"CHANNEL_INTERNAL_ISSUE\",\"CHANNEL_OTHER_ISSUE\",\"USER_UKNOWN\",\"USER_BLOCKED\",\"USER_UNAVAILABLE\",\"INTERNAL_NOT_IMPLEMENTED\",\"INTERNAL_OTHER_ISSUE\"],\"type\":\"string\"},\"details\":{\"description\":\"Additional information about the error\",\"type\":\"string\"}},\"required\":[\"code\"],\"type\":\"object\"},\"fallbackMessageId\":{\"description\":\"ID of the fallback message attached to this message\",\"type\":\"string\"},\"fallbackOrder\":{\"description\":\"Position in fallback tree (0 = topmost)\",\"type\":\"integer\"},\"messageId\":{\"type\":\"string\"},\"parentMessageId\":{\"description\":\"ID of the failed parent message (for fallback messages)\",\"type\":\"string\"},\"requestId\":{\"type\":\"string\"},\"scheduledAt\":{\"description\":\"Actual schedule time\",\"format\":\"date-time\",\"type\":\"string\"},\"status\":{\"description\":\"Message lifecycle status\",\"enum\":[\"SCHEDULE_QUEUED\",\"SCHEDULED\",\"SCHEDULE_DELETED\",\"SCHEDULE_DELETION_FAILED\",\"QUEUED\",\"SENT\",\"DELIVERED\",\"READ\",\"DELIVERY_RETRIED\",\"DELIVERY_FAILED\"],\"type\":\"string\"},\"userId\":{\"type\":\"string\"}},\"required\":[\"channelId\",\"userId\",\"messageId\",\"requestId\",\"status\"],\"type\":\"object\"},\"on\":{\"description\":\"UTC date-time when the event occurred\",\"format\":\"date-time\",\"type\":\"string\"},\"templateReviewStatusChanged\":{\"examples\":[{\"channelData\":{\"whatsapp.business.accountId\":\"199999999999999\",\"whatsapp.template.category\":\"MARKETING\",\"whatsapp.template.id\":\"213270854988610\",\"whatsapp.template.name\":\"acme_tpl3j9dc_promotion_ft92\"},\"channelId\":\"whatsapp\",\"details\":\"ToS violation\",\"meta\":{\"category\":\"promotion\",\"myTemplateId\":\"2023AZ3\",\"tags\":\"youngsters,sports,soccer\"},\"status\":\"REJECTED\",\"templateId\":\"tpl3J9dcH2HslZKNXssz\"}],\"properties\":{\"channelData\":{\"additionalProperties\":{\"type\":\"string\"},\"examples\":[{\"rcs.card.orientation\":\"HORIZONTAL\",\"sms.originatingAddress\":\"MYBRAND\"}],\"type\":\"object\"},\"channelId\":{\"type\":\"string\"},\"details\":{\"type\":\"string\"},\"meta\":{\"additionalProperties\":{\"type\":\"string\"},\"examples\":[{\"rcs.card.orientation\":\"HORIZONTAL\",\"sms.originatingAddress\":\"MYBRAND\"}],\"type\":\"object\"},\"status\":{\"description\":\"Template review lifecycle status\",\"enum\":[\"SUBMITTING\",\"SUBMITTED\",\"APPROVED\",\"REJECTED\",\"SUSPENDED\",\"DELETING\",\"DELETED\"],\"type\":\"string\"},\"templateId\":{\"type\":\"string\"}},\"required\":[\"templateId\",\"channelId\",\"status\"],\"type\":\"object\"},\"userMessageReceived\":{\"examples\":[{\"channelData\":{\"whatsapp.phoneNumber\":\"33155555555\",\"whatsapp.user.name\":\"Ignatius Reilly\"},\"channelId\":\"rcs\",\"content\":{\"postback\":{\"buttonType\":\"reply\",\"payload\":\"LOVE\",\"text\":\"J'aime\"}},\"replyToMessageId\":\"msgSzNvoD1OyIwWDS5KM0GSJ0\",\"userId\":\"33699999999\"}],\"properties\":{\"channelData\":{\"additionalProperties\":{\"type\":\"string\"},\"examples\":[{\"rcs.card.orientation\":\"HORIZONTAL\",\"sms.originatingAddress\":\"MYBRAND\"}],\"type\":\"object\"},\"channelId\":{\"type\":\"string\"},\"channelOperatorId\":{\"type\":\"string\"},\"content\":{\"description\":\"Content from the user. Exactly one of: text, postback, media, location, optin, optout, typing.\\n\",\"examples\":[{\"text\":\"Hello, what are your opening hours?\"}],\"properties\":{\"isReaction\":{\"description\":\"Whether the text (often emoji) is a reaction to a message\",\"type\":\"boolean\"},\"location\":{\"examples\":[{\"description\":\"Art museum - 1 Rue de la Legion d'Honneur, 75007 Paris\",\"latitude\":48.86015347854819,\"longitude\":2.326568685144047,\"title\":\"Musee d'Orsay\"}],\"properties\":{\"description\":{\"description\":\"Accompanying text description\",\"type\":\"string\"},\"latitude\":{\"description\":\"Latitude in degrees (plus/minus 90)\",\"format\":\"double\",\"type\":\"number\"},\"longitude\":{\"description\":\"Longitude in degrees (plus/minus 180)\",\"format\":\"double\",\"type\":\"number\"},\"title\":{\"description\":\"Short name of the location\",\"type\":\"string\"}},\"required\":[\"latitude\",\"longitude\"],\"type\":\"object\"},\"media\":{\"examples\":[{\"description\":\"An awesome picture!\",\"source\":\"https://example.com/picture.jpeg\",\"thumbnail\":\"https://example.com/thumbnail.jpg\",\"type\":\"image/jpeg\"}],\"properties\":{\"description\":{\"description\":\"Caption / media description\",\"type\":\"string\"},\"source\":{\"description\":\"Media resource URI\",\"type\":\"string\"},\"thumbnail\":{\"description\":\"Thumbnail image URI\",\"type\":\"string\"},\"type\":{\"description\":\"MIME type (e.g. image/gif, video/mp4)\",\"type\":\"string\"}},\"required\":[\"type\",\"source\"],\"type\":\"object\"},\"optin\":{\"description\":\"User opted in to receive messages\",\"examples\":[{\"payload\":\"{\\\"ref\\\": \\\"460650465065\\\"}\",\"text\":\"Get Started\"}],\"properties\":{\"payload\":{\"description\":\"Channel-specific tracking data\",\"type\":\"string\"},\"text\":{\"type\":\"string\"}},\"type\":\"object\"},\"optout\":{\"description\":\"User opted out from receiving messages\",\"examples\":[{\"text\":\"STOP\"}],\"properties\":{\"text\":{\"type\":\"string\"}},\"type\":\"object\"},\"postback\":{\"examples\":[{\"buttonType\":\"reply\",\"payload\":\"QUIZZ\",\"text\":\"Take a quizz!\"}],\"properties\":{\"buttonType\":{\"description\":\"Type of button that triggered the postback\",\"enum\":[\"reply\",\"openUrl\",\"dial\",\"createCalendarEvent\",\"shareLocation\",\"viewLocation\"],\"type\":\"string\"},\"payload\":{\"description\":\"Custom postback value from button press\",\"type\":\"string\"},\"text\":{\"description\":\"Visible text displayed to/by the user\",\"type\":\"string\"}},\"required\":[\"payload\"],\"type\":\"object\"},\"text\":{\"type\":\"string\"},\"typing\":{\"description\":\"User is typing (no properties)\",\"examples\":[{}],\"type\":\"object\"}},\"type\":\"object\"},\"context\":{\"additionalProperties\":{\"type\":\"string\"},\"description\":\"Free-form client-specific correlation values (max 50 entries, keys 1-50 chars, values max 500 chars)\",\"examples\":[{\"myCampaignId\":\"christmas-560650\",\"myUserId\":\"vincent@example.com\"}],\"maxProperties\":50,\"type\":\"object\"},\"replyToMessageId\":{\"description\":\"Original messageId this is a reply to\",\"type\":\"string\"},\"userId\":{\"type\":\"string\"}},\"required\":[\"channelId\",\"userId\",\"content\"],\"type\":\"object\"}},\"required\":[\"eventId\",\"on\",\"accountId\"],\"type\":\"object\"},\"type\":\"array\"}},\"required\":[\"events\"],\"type\":\"object\"}}},\"description\":\"Events found\"},\"400\":{\"content\":{\"application/json\":{\"schema\":{\"properties\":{\"error\":{\"description\":\"Error details\",\"type\":\"string\"}},\"type\":\"object\"}}},\"description\":\"Invalid request\"},\"401\":{\"content\":{\"application/json\":{\"schema\":{\"properties\":{\"error\":{\"description\":\"Error details\",\"type\":\"string\"}},\"type\":\"object\"}}},\"description\":\"Authentication failed\"},\"404\":{\"content\":{\"application/json\":{\"schema\":{\"properties\":{\"error\":{\"description\":\"Error details\",\"type\":\"string\"}},\"type\":\"object\"}}},\"description\":\"Resource not found\"},\"500\":{\"content\":{\"application/json\":{\"schema\":{\"properties\":{\"error\":{\"description\":\"Error details\",\"type\":\"string\"}},\"type\":\"object\"}}},\"description\":\"Internal server error\"}},\"security\":[{\"apiKey\":[]},{\"oauth2\":[]}],\"securitySchemes\":{\"apiKey\":{\"description\":\"API key for /v1 endpoints\",\"in\":\"header\",\"name\":\"x-api-key\",\"type\":\"apiKey\"},\"oauth2\":{\"description\":\"OAuth2 client credentials for /v2 endpoints\",\"flows\":{\"clientCredentials\":{\"scopes\":{},\"tokenUrl\":\"https://sso.linkmobility.com/auth/realms/CPaaS/protocol/openid-connect/token\"}},\"type\":\"oauth2\"}},\"securitySource\":\"definition\"}"
