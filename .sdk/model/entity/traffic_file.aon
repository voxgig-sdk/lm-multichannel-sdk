# Entity: traffic_file

main: kit: entity: traffic_file: {

  alias: field: {}

  fields: [
    {
      name: "files"
      req: true
      type: "`$ARRAY`"
    }
    {
      name: "id"
      req: false
      type: "`$STRING`"
    }
    {
      name: "path"
      req: true
      short: "Relative file path: /events/{year}/{month}/{day}/{hour}/{sequence}.zip"
      type: "`$STRING`"
    }
    {
      name: "url"
      req: true
      short: "Absolute download URL with security token (expires after 15 minutes)"
      type: "`$STRING`"
    }
  ]

  id: {
    field: "id"
    name: "id"
  }

  name: "traffic_file"
  op: {
    list: {
      name: "list"
      points: [
        {
          method: "GET"
          orig: "/traffic/files"
          segments: [
            {
              lit: "traffic"
            }
            {
              lit: "files"
            }
          ]
          transform: {
            req: "`reqdata`"
            res: "`body.files`"
          }
        }
      ]
    }
    load: {
      name: "load"
      points: [
        {
          args: {
            params: [
              {
                kind: "param"
                name: "id"
                orig: "path"
                reqd: true
                type: "`$STRING`"
              }
            ]
          }
          method: "GET"
          orig: "/traffic/files/{path}"
          rename: {
            param: {
              path: "id"
            }
          }
          segments: [
            {
              lit: "traffic"
            }
            {
              lit: "files"
            }
            {
              var: "id"
            }
          ]
          select: {
            exist: [
              "id"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }



}
