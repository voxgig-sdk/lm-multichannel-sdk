# BasicOptionFlow

main: kit: flow: BasicOptionFlow:
{
  entity: "option",
  kind: "basic",
  name: "BasicOptionFlow",
  step: [
    {
      input: {
        ref: "option_ref01"
      }

      match: {
        template_id: "template01"
      }

      op: "create"
    }

    {
      input: {
        ref: "option_ref01",
        srcdatavar: "option_ref01_data",
        suffix: "_up0"
      }

      op: "update",
      spec: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-option_ref01"
          }
        }
      ]
    }

    {
      input: {
        ref: "option_ref01",
        srcdatavar: "option_ref01_data",
        suffix: "_dt0"
      }

      match: {
        id: "option01"
      }

      op: "load",
      valid: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-option_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicOptionFlow"
}