# BasicMessageFlow

main: kit: flow: BasicMessageFlow:
{
  entity: "message",
  kind: "basic",
  name: "BasicMessageFlow",
  step: [
    {
      i: {
        ref: "message_ref01"
      }

      o: "create"
    }

    {
      i: {
        ref: "message_ref01",
        srcdatavar: "message_ref01_data",
        suffix: "_dt0"
      }

      m: {
        id: "message01"
      }

      o: "load",
      v: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-message_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "message_ref01",
        suffix: "_rm0"
      }

      m: {
        id: "message01"
      }

      o: "remove"
    }
  ],
  "key$": "BasicMessageFlow"
}